<Window x:Class="MdTracker.LiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="12" Foreground="White">
    <Grid>
        <!-- one card, always: who / turn & clocks / deck read / record / everything the opponent has shown, by zone -->
        <Border Background="#D9111827" CornerRadius="10" Padding="12,8" Width="300" MouseDown="Panel_MouseDown">
            <StackPanel>
                <TextBlock x:Name="StripHead" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="StripTurn" Foreground="#CBD5E1" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="StripDeck" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="StripMatchup" Foreground="#93C5FD" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                <!-- no visible scrollbar: it sat on top of the count column; the wheel still scrolls -->
                <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="StripRows"/>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Window>
