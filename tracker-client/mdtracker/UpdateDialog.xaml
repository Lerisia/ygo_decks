<Window x:Class="MdTracker.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YGO Decks 트래커" Width="380" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F6F7FB" FontFamily="Segoe UI, Malgun Gothic" FontSize="13" Topmost="True">
    <StackPanel Margin="20">
        <TextBlock Text="새 버전의 트래커가 있습니다." FontWeight="SemiBold" FontSize="14"/>
        <TextBlock Text="지금 업데이트하시겠습니까?" Margin="0,6,0,16"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="네" Width="80" Margin="0,0,8,0" Click="Yes_Click" IsDefault="True"/>
            <Button Content="나중에" Width="80" Style="{StaticResource Secondary}" Click="Later_Click" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
