<Window x:Class="MdTracker.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        FontFamily="pack://application:,,,/Fonts/#Pretendard" FontSize="13" Foreground="White">
    <Border Background="#E6111827" CornerRadius="12" Padding="16" Width="440" MouseDown="Card_MouseDown">
        <StackPanel>
            <!-- headline -->
            <DockPanel Margin="0,0,0,8">
                <Border x:Name="ResultBadge" Background="#22C55E" CornerRadius="999" Padding="8,2" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="ResultText" Text="승리" FontWeight="SemiBold"/>
                </Border>
                <TextBlock x:Name="Headline" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="Countdown" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#9CA3AF"/>
            </DockPanel>
            <TextBlock x:Name="SubLine" Foreground="#CBD5E1" Margin="0,0,0,10"/>

            <!-- my deck -->
            <TextBlock Text="내 덱" Foreground="#9CA3AF" FontSize="11"/>
            <Grid Margin="0,2,0,8">
                <TextBox x:Name="MyDeckBox" Background="#1F2937" Foreground="White" BorderBrush="#374151" CaretBrush="White"
                         TextChanged="MyDeckBox_TextChanged" GotKeyboardFocus="Input_Focus" PreviewKeyDown="DeckBox_PreviewKeyDown"/>
            </Grid>
            <ListBox x:Name="MyDeckList" Visibility="Collapsed" MaxHeight="130" Background="#111827" Foreground="White" BorderBrush="#374151"
                     Margin="0,-8,0,8" SelectionChanged="MyDeckList_SelectionChanged"/>

            <!-- opponent deck -->
            <DockPanel>
                <TextBlock Text="상대 덱" Foreground="#9CA3AF" FontSize="11" DockPanel.Dock="Left"/>
                <TextBlock x:Name="OppHint" Foreground="#9CA3AF" FontSize="11" HorizontalAlignment="Right"/>
            </DockPanel>
            <Grid Margin="0,2,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="OppDeckBox" Grid.Column="0" Background="#1F2937" Foreground="White" BorderBrush="#374151" CaretBrush="White"
                         TextChanged="OppDeckBox_TextChanged" GotKeyboardFocus="Input_Focus" PreviewKeyDown="DeckBox_PreviewKeyDown"/>
                <Button Grid.Column="2" Content="모름" Style="{StaticResource Ghost}" Padding="10,4" Click="Unknown_Click"/>
            </Grid>
            <ListBox x:Name="OppDeckList" Visibility="Collapsed" MaxHeight="130" Background="#111827" Foreground="White" BorderBrush="#374151"
                     Margin="0,-8,0,8" SelectionChanged="OppDeckList_SelectionChanged"/>

            <TextBlock x:Name="MatchupText" Foreground="#93C5FD" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>

            <!-- opponent cards -->
            <TextBlock x:Name="CardsLabel" Text="상대가 보여준 카드" Foreground="#9CA3AF" FontSize="11"/>
            <WrapPanel x:Name="CardsPanel" Margin="0,2,0,8"/>

            <!-- memo -->
            <TextBlock Text="메모" Foreground="#9CA3AF" FontSize="11"/>
            <TextBox x:Name="MemoBox" Margin="0,2,0,10" Background="#1F2937" Foreground="White" BorderBrush="#374151" CaretBrush="White"
                     GotKeyboardFocus="Input_Focus" TextChanged="Input_Changed"/>

            <!-- actions -->
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="SaveBtn" Content="저장" Click="Save_Click" Margin="0,0,6,0"/>
                    <Button Content="기록 안 함" Style="{StaticResource Ghost}" Click="Discard_Click"/>
                </StackPanel>
                <TextBlock x:Name="Msg" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#FCA5A5" TextWrapping="Wrap" MaxWidth="150"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
