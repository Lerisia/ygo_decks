<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <AssemblyName>mdtracker</AssemblyName>
    <RootNamespace>MdTracker</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.1</Version>
    <Product>YGO Decks Recorder</Product>
    <AssemblyTitle>YGO Decks Recorder</AssemblyTitle>
    <Description>Records Master Duel results to ygodecks.com</Description>
    <Company>ygodecks.com</Company>
  </PropertyGroup>

  <!-- dotnet publish -p:TestBuild=true: the password-locked test build (leak kept visible, whole captures sent, no updates) -->
  <PropertyGroup Condition="'$(TestBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);TEST_BUILD</DefineConstants>
  </PropertyGroup>

  <!-- dotnet publish -p:HiddenMemory=true: a build where overlay mode 3 can be picked (opponent cards followed into
       hidden zones: hand, set cards, deck). Never the public download while that memory is reworked (since 0.6.12). -->
  <PropertyGroup Condition="'$(HiddenMemory)' == 'true'">
    <DefineConstants>$(DefineConstants);HIDDEN_MEMORY</DefineConstants>
  </PropertyGroup>

  <!-- Pretendard (OFL) embedded so every machine renders the same UI font. -->
  <ItemGroup>
    <Resource Include="Fonts\Pretendard-Regular.ttf" />
    <Resource Include="Fonts\Pretendard-SemiBold.ttf" />
  </ItemGroup>

  <!-- Compile time, shown in the window title so test builds can be told apart. -->
  <ItemGroup>
    <AssemblyMetadata Include="BuildStamp" Value="$([System.DateTime]::Now.ToString('MM-dd HH:mm'))" />
  </ItemGroup>

  <!-- Research uploads (clock probe) need the site's snapshot key; the file is git-ignored and optional. -->
  <ItemGroup Condition="Exists('snapshot.key')">
    <EmbeddedResource Include="snapshot.key" LogicalName="snapshot.key" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="chime.wav" LogicalName="chime.wav" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../mdpeek/Mem.cs" Link="core/Mem.cs" />
    <Compile Include="../mdpeek/Native.cs" Link="core/Native.cs" />
    <Compile Include="../mdpeek/Il2Cpp.cs" Link="core/Il2Cpp.cs" />
    <Compile Include="../mdpeek/Game.cs" Link="core/Game.cs" />
  </ItemGroup>

</Project>
