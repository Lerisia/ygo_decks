<Window x:Class="MdTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YGO Decks 트래커" Width="560" Height="520" MinWidth="480" MinHeight="420"
        Background="#F6F7FB" FontFamily="Segoe UI, Malgun Gothic" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="YGO Decks 트래커" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse x:Name="Dot" Width="9" Height="9" Fill="#F59E0B" Margin="0,0,6,0"/>
                <TextBlock x:Name="StatusText" Text="…" Foreground="{StaticResource Muted}"/>
            </StackPanel>
        </DockPanel>

        <!-- login -->
        <Border Grid.Row="1" x:Name="LoginPanel" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="로그인" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="ygodecks.com 계정으로 로그인하면 게임이 자동으로 기록됩니다. 비밀번호는 저장하지 않습니다." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="EmailBox" Grid.Column="0" ToolTip="이메일"/>
                    <PasswordBox x:Name="PwBox" Grid.Column="2" ToolTip="비밀번호" KeyDown="PwBox_KeyDown"/>
                    <Button x:Name="LoginBtn" Grid.Column="4" Content="로그인" Click="LoginBtn_Click"/>
                </Grid>
                <TextBlock x:Name="LoginMsg" Foreground="#DC2626" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- setup -->
        <Border Grid.Row="2" x:Name="SetupPanel" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock x:Name="AccountText" Foreground="{StaticResource Muted}" DockPanel.Dock="Left"/>
                    <Button Content="로그아웃" Style="{StaticResource Secondary}" HorizontalAlignment="Right" Padding="10,4" Click="Logout_Click"/>
                </DockPanel>
                <TextBlock Text="기록할 시트" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="GroupBox" Grid.Column="0" SelectionChanged="GroupBox_SelectionChanged"/>
                    <Button Grid.Column="2" Content="새로고침" Style="{StaticResource Secondary}" Click="RefreshGroups_Click"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewGroupBox" Grid.Column="0" ToolTip="새 시트 이름 (예: 2026-09 시즌)"/>
                    <Button Grid.Column="2" Content="새 시트 만들기" Style="{StaticResource Secondary}" Click="CreateGroup_Click"/>
                </Grid>
                <TextBlock x:Name="SetupMsg" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="게임이 끝나면 게임 화면 위에 확인 창이 잠깐 뜹니다. 게임은 창모드 또는 테두리 없는 창모드로 두세요(전체화면이면 게임 위에 표시되지 않습니다)."/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="오버레이 미리보기" Style="{StaticResource Secondary}" Click="Demo_Click" Margin="0,0,8,0"/>
                    <Button Content="사이트에서 시트 보기" Style="{StaticResource Secondary}" Click="OpenSite_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- recent games -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14">
            <DockPanel>
                <TextBlock Text="최근 게임" FontWeight="SemiBold" DockPanel.Dock="Top" Margin="0,0,0,6"/>
                <ListView x:Name="RecentList" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="시간" Width="90" DisplayMemberBinding="{Binding Time}"/>
                            <GridViewColumn Header="상대" Width="110" DisplayMemberBinding="{Binding Opp}"/>
                            <GridViewColumn Header="결과" Width="50" DisplayMemberBinding="{Binding Result}"/>
                            <GridViewColumn Header="내 덱 / 상대 덱" Width="170" DisplayMemberBinding="{Binding Decks}"/>
                            <GridViewColumn Header="상태" Width="80" DisplayMemberBinding="{Binding State}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>
    </Grid>
</Window>
