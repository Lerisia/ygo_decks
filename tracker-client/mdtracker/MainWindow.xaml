<Window x:Class="MdTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YGO Decks 트래커" Width="760" Height="880" MinWidth="640" MinHeight="620"
        Background="#F6F7FB" FontFamily="pack://application:,,,/Fonts/#Pretendard" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="YGO Decks 트래커" FontSize="18" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Ellipse x:Name="Dot" Width="9" Height="9" Fill="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="…" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>

        <!-- update notice -->
        <Border Grid.Row="0" x:Name="UpdateBanner" Visibility="Collapsed" Background="#FEF3C7" CornerRadius="10" Padding="12,10" Margin="0,44,0,8">
            <DockPanel>
                <Button x:Name="UpdateBtn" Content="지금 업데이트" DockPanel.Dock="Right" Background="#D97706" Click="Update_Click"/>
                <TextBlock x:Name="UpdateText" Foreground="#92400E" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"
                           Text="새 버전이 있습니다."/>
            </DockPanel>
        </Border>

        <!-- login -->
        <Border Grid.Row="1" x:Name="LoginPanel" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="로그인" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="EmailBox" Grid.Column="0" ToolTip="이메일"/>
                    <PasswordBox x:Name="PwBox" Grid.Column="2" ToolTip="비밀번호" KeyDown="PwBox_KeyDown"/>
                    <Button x:Name="LoginBtn" Grid.Column="4" Content="로그인" Click="LoginBtn_Click"/>
                </Grid>
                <TextBlock x:Name="LoginMsg" Foreground="#DC2626" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- setup -->
        <Border Grid.Row="2" x:Name="SetupPanel" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock x:Name="AccountText" Foreground="{StaticResource Muted}" DockPanel.Dock="Left"/>
                    <Button Content="로그아웃" Style="{StaticResource Secondary}" HorizontalAlignment="Right" Padding="10,4" Click="Logout_Click"/>
                </DockPanel>
                <Border x:Name="NoSheetWarn" Background="#FEE2E2" CornerRadius="8" Padding="10,8" Margin="0,0,0,8" Visibility="Collapsed">
                    <TextBlock Foreground="#991B1B" TextWrapping="Wrap" FontWeight="SemiBold"
                               Text="⚠ 기록할 시트가 없어 게임이 기록되지 않습니다. 아래에서 시트를 만들어 주세요."/>
                </Border>
                <TextBlock Text="기록할 시트" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="GroupBox" Grid.Column="0" SelectionChanged="GroupBox_SelectionChanged"/>
                    <Button Grid.Column="2" Content="새로고침" Style="{StaticResource Secondary}" Click="RefreshGroups_Click"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewGroupBox" Grid.Column="0" ToolTip="새 시트 이름 (예: 2026-09 시즌)"/>
                    <Button Grid.Column="2" Content="새 시트 만들기" Style="{StaticResource Secondary}" Click="CreateGroup_Click"/>
                </Grid>
                <TextBlock x:Name="SetupMsg" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="게임 위 오버레이" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="OverlayModeBox" MinWidth="150" SelectionChanged="OverlayModeBox_SelectionChanged">
                        <ComboBoxItem Content="끄기"/>
                        <ComboBoxItem Content="전적만"/>
                        <ComboBoxItem Content="전체"/>
                    </ComboBox>
                </StackPanel>
                <CheckBox x:Name="AlertBox" Margin="0,6,0,0" Checked="Alert_Changed" Unchecked="Alert_Changed"
                          Content="게임을 내려놓은 동안 내 차례가 오면 소리로 알림"/>
                <CheckBox x:Name="AutoStartBox" Margin="0,6,0,0" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"
                          Content="Windows 시작 시 자동 실행"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="오버레이 글자 크기" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ScaleBox" MinWidth="110" SelectionChanged="ScaleBox_SelectionChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="사이트에서 시트 보기" Style="{StaticResource Secondary}" Click="OpenSite_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- today -->
        <Border Grid.Row="3" x:Name="TodayPanel" Visibility="Collapsed" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <ComboBox x:Name="TodayDeckBox" DockPanel.Dock="Right" MinWidth="170" Visibility="Collapsed" SelectionChanged="TodayDeckBox_SelectionChanged"/>
                    <TextBlock Text="오늘의 전적" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="TodayText" TextWrapping="Wrap" LineHeight="20"/>
            </StackPanel>
        </Border>

        <!-- recent games -->
        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14">
            <DockPanel>
                <TextBlock Text="최근 게임" FontWeight="SemiBold" DockPanel.Dock="Top" Margin="0,0,0,6"/>
                <ListView x:Name="RecentList" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="RecentList_MouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="시간" Width="75" DisplayMemberBinding="{Binding Time}"/>
                            <GridViewColumn Header="결과" Width="40" DisplayMemberBinding="{Binding Result}"/>
                            <GridViewColumn Header="코인" Width="60" DisplayMemberBinding="{Binding Coin}"/>
                            <GridViewColumn Header="선후공" Width="60" DisplayMemberBinding="{Binding Turn}"/>
                            <GridViewColumn Header="내 덱" Width="120" DisplayMemberBinding="{Binding MyDeck}"/>
                            <GridViewColumn Header="상대 덱" Width="120" DisplayMemberBinding="{Binding OppDeck}"/>
                            <GridViewColumn Header="상대" Width="85" DisplayMemberBinding="{Binding Opp}"/>
                            <GridViewColumn Header="랭크 / 레이팅" Width="115" DisplayMemberBinding="{Binding Rank}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>
    </Grid>
</Window>
