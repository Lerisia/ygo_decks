<Window x:Class="MdTracker.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="기록 수정" Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F6F7FB" FontFamily="pack://application:,,,/Fonts/#Pretendard" FontSize="13">
    <StackPanel Margin="16">
        <TextBlock x:Name="Headline" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="결과" Foreground="{StaticResource Muted}" FontSize="11"/>
                <ComboBox x:Name="ResultBox"><ComboBoxItem Content="승리" Tag="win"/><ComboBoxItem Content="패배" Tag="lose"/></ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="코인" Foreground="{StaticResource Muted}" FontSize="11"/>
                <ComboBox x:Name="CoinBox"><ComboBoxItem Content="앞면" Tag="win"/><ComboBoxItem Content="뒷면" Tag="lose"/></ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="선후공" Foreground="{StaticResource Muted}" FontSize="11"/>
                <ComboBox x:Name="FirstBox"><ComboBoxItem Content="선공" Tag="first"/><ComboBoxItem Content="후공" Tag="second"/></ComboBox>
            </StackPanel>
        </Grid>

        <TextBlock Text="내 덱" Foreground="{StaticResource Muted}" FontSize="11"/>
        <TextBox x:Name="MyDeckBox" Margin="0,2,0,0" TextChanged="MyDeckBox_TextChanged"/>
        <ListBox x:Name="MyDeckList" Visibility="Collapsed" MaxHeight="120" SelectionChanged="MyDeckList_SelectionChanged"/>

        <DockPanel Margin="0,8,0,0">
            <TextBlock Text="상대 덱" Foreground="{StaticResource Muted}" FontSize="11" DockPanel.Dock="Left"/>
        </DockPanel>
        <Grid Margin="0,2,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="OppDeckBox" Grid.Column="0" TextChanged="OppDeckBox_TextChanged"/>
            <Button Grid.Column="2" Content="모름" Style="{StaticResource Secondary}" Padding="10,4" Click="Unknown_Click"/>
        </Grid>
        <ListBox x:Name="OppDeckList" Visibility="Collapsed" MaxHeight="120" SelectionChanged="OppDeckList_SelectionChanged"/>

        <TextBlock Text="메모" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/>
        <TextBox x:Name="MemoBox" Margin="0,2,0,0"/>
        <DockPanel Margin="0,10,0,0">
            <TextBlock x:Name="Msg" Foreground="#DC2626" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="취소" Style="{StaticResource Secondary}" Margin="0,0,6,0" Click="Cancel_Click"/>
                <Button x:Name="SaveBtn" Content="저장" Click="Save_Click"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
