# Backend: Ignore Python cache. Migrations are kept in git (2026-10-12): each branch carries its own, so two pieces of
# work making the same number meet at rebase rather than on the live database.
backend/**/__pycache__/
backend/**/migrations/*.pyc

# Backend: Ignore database files
backend/*.sqlite3
backend/*.json
backend/*.csv
backend/*.db
backend/staticfiles/*

# Backend: Ignore Django settings & logs
backend/.env
backend/*.log
backend/*.pyc

# Backend: Ignore media files
backend/media/*

# Backend: Ignore virtual environment (venv)
backend/venv/
backend/venv
backend/.venv/
venv/
.venv/

# Frontend: Ignore Node.js dependencies & build files
frontend/node_modules/
frontend/.next/
frontend/dist/
frontend/build/
frontend/.env.local
frontend/.cache/
frontend/yarn.lock
frontend/package-lock.json
frontend/coverage/
frontend/.DS_Store

# Global: Ignore system files
.DS_Store
Thumbs.db

frontend/src/data/lookup_table.json
backend/lookup_table.json

# node_modules (a worktree's are links to the deploy tree's: no trailing slash, a link is no folder to git)
node_modules/
/node_modules

# media files
media/

# files related to deep learning
*.pt
*.pth
*.csv

# Signing keys & certificates
*.jks
*.pem

# Bot: secrets and local venv
bot/.env
bot/venv/
bot/__pycache__/
bot/sessions.json
bot/history.json
bot/*.tmp

# Local logs & scratch files
logs/
temp/
backend/logs/
backend/tournament_legacy_backup_*.sql

backend/db.sqlite3-*

# raw PC tracker snapshots (research data, may contain player info)
backend/data/tracker_snapshots/

# tracker-client (.NET) build outputs
tracker-client/**/bin/
tracker-client/**/obj/
tracker-client/**/publish/
tracker-client/**/publish-linux/
tracker-client/mdtracker/snapshot.key
backend/data/tracker_test_key.txt
