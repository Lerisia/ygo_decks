# Discord bot token — from https://discord.com/developers/applications
# Paste the value here, DO NOT commit the real .env.
DISCORD_BOT_TOKEN=

# (Optional) Channel ID the bot listens in.
# Leave EMPTY to accept ONLY DMs from whitelisted users.
# If set, bot also accepts messages in this specific channel.
COOP_CHANNEL_ID=

# Comma-separated Discord user IDs allowed to send requests.
# Leave EMPTY to allow ANY user inside COOP_CHANNEL_ID (DMs still refused).
ALLOWED_USER_IDS=

# NOTE: ANTHROPIC_API_KEY is intentionally NOT read. The bot uses the local
# `claude` CLI login (from `claude login`) so requests count against the
# subscription (Max/Pro), not per-token API billing. If you want API-key
# billing instead, edit main.py to keep ANTHROPIC_API_KEY in the subprocess env.

# Project root (default is fine if repo lives at /home/elyss/ygo_decks)
PROJECT_DIR=/home/elyss/ygo_decks

# Optional: path to claude CLI. Auto-detected via `which claude` if unset.
# CLAUDE_BIN=/home/elyss/.nvm/versions/node/v22.14.0/bin/claude

# Optional: max seconds a single Claude invocation is allowed to run.
CLAUDE_TIMEOUT_SEC=900
